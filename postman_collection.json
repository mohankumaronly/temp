{
	"info": {
		"_postman_id": "8f3b4c10-91a2-4d5e-b873-123456789abc",
		"name": "Resume Analyzer & Authentication API Collection",
		"description": "Complete Postman Collection for testing Spring Boot Authentication & Resume Processing Endpoints including OTP Email verification, Login, JWT authentication, Resume Uploads, Text Extraction, and Status Tracking.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "testEmail",
			"value": "testuser@example.com",
			"type": "string"
		},
		{
			"key": "testPassword",
			"value": "Password123!",
			"type": "string"
		},
		{
			"key": "newPassword",
			"value": "NewPassword123!",
			"type": "string"
		},
		{
			"key": "otpCode",
			"value": "123456",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"health"
					]
				},
				"description": "Checks if the backend authentication server is running."
			},
			"response": []
		},
		{
			"name": "2. Register User (Send OTP Email)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				},
				"description": "Registers a new user and sends a 6-digit OTP code to their email via Brevo SMTP."
			},
			"response": []
		},
		{
			"name": "3. Request / Resend OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/otp/request",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"otp",
						"request"
					]
				},
				"description": "Requests a new OTP email for the specified email address."
			},
			"response": []
		},
		{
			"name": "4. Verify OTP & Authenticate",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.accessToken) {",
							"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
							"}",
							"if (jsonData.refreshToken) {",
							"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/otp/verify",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"otp",
						"verify"
					]
				},
				"description": "Validates the 6-digit OTP received via email, marks email as verified, returns JWT access token and refresh token."
			},
			"response": []
		},
		{
			"name": "5. User Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.accessToken) {",
							"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
							"}",
							"if (jsonData.refreshToken) {",
							"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Authenticates an existing verified user with email and password."
			},
			"response": []
		},
		{
			"name": "6. Get User Profile (/users/me)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/users/me",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"me"
					]
				},
				"description": "Protected endpoint that returns current logged-in user details using JWT Bearer token or HttpOnly Cookie."
			},
			"response": []
		},
		{
			"name": "7. Refresh Access Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.accessToken) {",
							"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
							"}",
							"if (jsonData.refreshToken) {",
							"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/refresh",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"refresh"
					]
				},
				"description": "Exchanges a valid refresh token for a new access token and new refresh token."
			},
			"response": []
		},
		{
			"name": "8. Forgot Password (Request OTP)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				},
				"description": "Triggers a password reset 6-digit OTP to the user's email."
			},
			"response": []
		},
		{
			"name": "9. Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/reset-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"reset-password"
					]
				},
				"description": "Verifies the reset OTP code and updates the user password."
			},
			"response": []
		},
		{
			"name": "10. User Logout",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.collectionVariables.set('accessToken', '');",
							"pm.collectionVariables.set('refreshToken', '');",
							"console.log('Cleared tokens on logout');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/logout",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"logout"
					]
				},
				"description": "Revokes active refresh tokens in database and clears session cookies."
			},
			"response": []
		},
		{
			"name": "11. Upload Resumes",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "files",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/resumes/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"resumes",
						"upload"
					]
				},
				"description": "Uploads one or multiple PDF resume files to Cloudinary and saves metadata as UPLOADED in MySQL."
			},
			"response": []
		},
		{
			"name": "12. Process Uploaded Resumes (Text Extraction)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/resumes/process",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"resumes",
						"process"
					]
				},
				"description": "Finds all UPLOADED resumes in database, downloads PDFs from Cloudinary, extracts text using PDFBox, and updates status to COMPLETED."
			},
			"response": []
		},
		{
			"name": "13. Get My Resumes",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/resumes/my",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"resumes",
						"my"
					]
				},
				"description": "Gets all uploaded resumes belonging to the currently authenticated user."
			},
			"response": []
		},
		{
			"name": "14. Get Resume by ID",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/resumes/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"resumes",
						"1"
					]
				},
				"description": "Gets single resume details including extracted text and status by ID for the logged-in user."
			},
			"response": []
		}
	]
}
